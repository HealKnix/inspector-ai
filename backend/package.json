{
  "name": "@inspector-ai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "bun run prisma:generate && nest build --path tsconfig.build.json",
    "start": "bun dist/main.js",
    "eslint": "eslint .",
    "typecheck": "bun run prisma:generate && tsc --noEmit",
    "test": "bun run prisma:generate && vitest run",
    "test:watch": "bun run prisma:generate && vitest",
    "test:coverage": "bun run prisma:generate && vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "unplugin-swc": "^1.5.7",
    "vitest": "^5.0.1"
  }
}
