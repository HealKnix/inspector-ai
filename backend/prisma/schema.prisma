generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INSPECTOR
  ADMINISTRATOR
  ML_ENGINEER
}

model User {
  id                  String               @id @default(uuid())
  login               String               @unique @db.VarChar(64)
  passwordHash        String               @map("password_hash")
  role                Role?                @default(INSPECTOR)
  lastName            String               @map("last_name") @db.VarChar(100)
  firstName           String               @map("first_name") @db.VarChar(100)
  patronymic          String?              @db.VarChar(100)
  phone               String?              @db.VarChar(32)
  email               String?              @db.VarChar(320)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  authSessions        AuthSession[]
  createdObjects      ConstructionObject[] @relation("ObjectCreator")
  objectAccess        ObjectAccess[]       @relation("ObjectMember")
  grantedObjectAccess ObjectAccess[]       @relation("AccessGrantor")
  uploadedFiles       File[]
  uploadReceipts      UploadReceipt[]
  auditEvents         AuditEvent[]
  findingDecisions    FindingDecision[]

  @@map("users")
}

model ConstructionObject {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator     User             @relation("ObjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  access      ObjectAccess[]
  processes   Process[]
  files       File[]
  receipts    UploadReceipt[]
  auditEvents AuditEvent[]
  packages    PackageVersion[]

  @@index([createdAt, id])
  @@map("objects")
}

model ObjectAccess {
  objectId  String             @map("object_id") @db.Uuid
  userId    String             @map("user_id")
  grantedBy String             @map("granted_by")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  object    ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  user      User               @relation("ObjectMember", fields: [userId], references: [id], onDelete: Restrict)
  grantor   User               @relation("AccessGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@id([objectId, userId])
  @@index([userId, objectId])
  @@map("object_access")
}

model AuthSession {
  id               String    @id
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum ProcessStatus {
  PENDING
  PARSING
  READY
  VERIFYING
  COMPLETED
  FINALIZED
}

model Process {
  id        String             @id @default(uuid()) @db.Uuid
  objectId  String             @map("object_id") @db.Uuid
  status    ProcessStatus      @default(PENDING)
  version   Int                @default(1)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  object    ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  runs      Run[]
  protocols Protocol[]
  documents Document[]

  @@unique([id, objectId])
  @@index([objectId, createdAt])
  @@map("processes")
}

model Run {
  id                      String                  @id @default(uuid()) @db.Uuid
  processId               String                  @map("process_id") @db.Uuid
  objectId                String                  @map("object_id") @db.Uuid
  version                 Int
  inputManifest           Json                    @map("input_manifest")
  inputManifestHash       String                  @map("input_manifest_hash") @db.Char(64)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  process                 Process                 @relation(fields: [processId, objectId], references: [id, objectId], onDelete: Restrict)
  files                   File[]
  inputs                  RunInput[]
  receipts                UploadReceipt[]
  jobs                    Job[]
  parsingTasks            ParsingTask[]
  completenessResults     CompletenessResult[]
  protocols               Protocol[]
  documentParts           FileDocumentPart[]
  identificationSnapshots ResolvedInputSnapshot[]
  evidenceGroups          EvidenceGroup[]

  @@unique([id, processId, objectId])
  @@unique([processId, version])
  @@map("runs")
}

model File {
  id                 String             @id @default(uuid()) @db.Uuid
  objectId           String             @map("object_id") @db.Uuid
  processId          String             @map("process_id") @db.Uuid
  runId              String             @map("run_id") @db.Uuid
  originalName       String             @map("original_name")
  format             String
  size               Int
  sha256             String             @db.Char(64)
  storageKey         String             @unique @map("storage_key") @db.Uuid
  uploadedBy         String             @map("uploaded_by")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  integrityCheckedAt DateTime?          @map("integrity_checked_at") @db.Timestamptz(3)
  corruptedAt        DateTime?          @map("corrupted_at") @db.Timestamptz(3)
  object             ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  uploader           User               @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  run                Run                @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  inputs             RunInput[]
  content            ObjectFileContent?
  parsingTasks       ParsingTask[]
  documentParts      FileDocumentPart[]

  @@unique([id, processId, objectId])
  @@unique([id, objectId, sha256])
  @@index([objectId, createdAt, id])
  @@map("files")
}

// A canonical original for each object/hash; historical duplicate Files remain intact.
// Populated by the files INSERT trigger so concurrent/direct writes obey uniqueness.
model ObjectFileContent {
  objectId String @map("object_id") @db.Uuid
  sha256   String @db.Char(64)
  fileId   String @map("file_id") @db.Uuid
  file     File   @relation(fields: [fileId, objectId, sha256], references: [id, objectId, sha256], onDelete: Restrict, onUpdate: Restrict)

  @@id([objectId, sha256])
  @@unique([fileId, objectId, sha256])
  @@map("object_file_contents")
}

model RunInput {
  runId     String @map("run_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  processId String @map("process_id") @db.Uuid
  objectId  String @map("object_id") @db.Uuid
  run       Run    @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  file      File   @relation(fields: [fileId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)

  @@id([runId, fileId])
  @@map("run_inputs")
}

model UploadReceipt {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id")
  objectId       String             @map("object_id") @db.Uuid
  clientUploadId String             @map("client_upload_id") @db.Uuid
  fingerprint    String             @db.Char(64)
  processId      String?            @map("process_id") @db.Uuid
  runId          String?            @map("run_id") @db.Uuid
  httpStatus     Int                @map("http_status")
  response       Json
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  object         ConstructionObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  run            Run?               @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)

  @@unique([userId, objectId, clientUploadId])
  @@index([objectId, userId, createdAt])
  @@map("upload_receipts")
}

model Job {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  processId String   @map("process_id") @db.Uuid
  objectId  String   @map("object_id") @db.Uuid
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  run       Run      @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  outbox    Outbox[]

  @@unique([runId, kind])
  @@map("jobs")
}

model Outbox {
  id          String    @id @default(uuid()) @db.Uuid
  jobId       String?   @map("job_id") @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseToken  String?   @map("lease_token") @db.Uuid
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([deliveredAt, availableAt])
  @@map("outbox")
}

model AuditEvent {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id")
  objectId  String?             @map("object_id") @db.Uuid
  action    String
  requestId String              @map("request_id") @db.Uuid
  ip        String?
  details   Json
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  object    ConstructionObject? @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@index([objectId, createdAt])
  @@map("audit_events")
}

// Each manual retry is a separate immutable execution cycle; broker redelivery
// never resets attempts. States here are technical, not ProcessStatus values.
model ParsingTask {
  id                   String                @id @default(uuid()) @db.Uuid
  runId                String                @map("run_id") @db.Uuid
  fileId               String                @map("file_id") @db.Uuid
  processId            String                @map("process_id") @db.Uuid
  objectId             String                @map("object_id") @db.Uuid
  cycle                Int                   @default(1)
  state                String                @default("queued")
  attempts             Int                   @default(0)
  capacityDeferrals    Int                   @default(0) @map("capacity_deferrals")
  availableAt          DateTime              @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseUntil           DateTime?             @map("lease_until") @db.Timestamptz(3)
  leaseToken           String?               @map("lease_token") @db.Uuid
  dispatchedAt         DateTime?             @map("dispatched_at") @db.Timestamptz(3)
  pipelineFingerprint  String?               @map("pipeline_fingerprint") @db.Char(64)
  pagesCompleted       Int                   @default(0) @map("pages_completed")
  pagesTotal           Int?                  @map("pages_total")
  phase                String?
  progressUpdatedAt    DateTime?             @map("progress_updated_at") @db.Timestamptz(3)
  waitingReason        String?               @map("waiting_reason")
  checkpointValidated  Boolean?              @map("checkpoint_validated")
  checkpointPages      Int?                  @map("checkpoint_pages")
  currentPage          Int?                  @map("current_page")
  previousAttemptError String?               @map("previous_attempt_error")
  progressResetReason  String?               @map("progress_reset_reason")
  modelsReadyDeadline  DateTime?             @map("models_ready_deadline") @db.Timestamptz(3)
  errorCode            String?               @map("error_code")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt          DateTime?             @map("completed_at") @db.Timestamptz(3)
  run                  Run                   @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  file                 File                  @relation(fields: [fileId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  artifact             ParseArtifact?
  retryReceipts        ParsingRetryReceipt[]

  @@unique([runId, fileId, cycle])
  @@index([state, availableAt, leaseUntil])
  @@index([state, modelsReadyDeadline])
  @@map("parsing_tasks")
}

model ParseArtifact {
  id                  String               @id @default(uuid()) @db.Uuid
  taskId              String               @unique @map("task_id") @db.Uuid
  sourceSha256        String               @map("source_sha256") @db.Char(64)
  pipelineFingerprint String               @map("pipeline_fingerprint") @db.Char(64)
  storageKey          String               @map("storage_key") @db.Uuid
  artifactSha256      String               @map("artifact_sha256") @db.Char(64)
  quality             String
  reasons             String[]
  pagesTotal          Int                  @map("pages_total")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  task                ParsingTask          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  classifications     ClassificationTask[]
  extractions         ExtractionTask[]
  documentParts       FileDocumentPart[]

  @@index([sourceSha256, pipelineFingerprint])
  @@map("parse_artifacts")
}

// A classification is bound to one immutable parser result. Retrying or changing
// the classifier creates a new cycle, preserving the previous machine result.
model ClassificationTask {
  id            String                       @id @default(uuid()) @db.Uuid
  artifactId    String                       @map("artifact_id") @db.Uuid
  cycle         Int                          @default(1)
  fingerprint   String                       @db.Char(64)
  state         String                       @default("queued")
  attempts      Int                          @default(0)
  availableAt   DateTime                     @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt  DateTime?                    @map("dispatched_at") @db.Timestamptz(3)
  leaseUntil    DateTime?                    @map("lease_until") @db.Timestamptz(3)
  leaseToken    String?                      @map("lease_token") @db.Uuid
  errorCode     String?                      @map("error_code")
  result        Json?
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?                    @map("completed_at") @db.Timestamptz(3)
  artifact      ParseArtifact                @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  retryReceipts ClassificationRetryReceipt[]

  @@unique([artifactId, cycle])
  @@index([state, availableAt, leaseUntil])
  @@map("classification_tasks")
}

model ClassificationRetryReceipt {
  userId    String             @map("user_id")
  objectId  String             @map("object_id") @db.Uuid
  requestId String             @map("request_id") @db.Uuid
  taskId    String             @map("task_id") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  task      ClassificationTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([userId, objectId, requestId])
  @@map("classification_retry_receipts")
}

model ParsingRetryReceipt {
  userId    String      @map("user_id")
  objectId  String      @map("object_id") @db.Uuid
  requestId String      @map("request_id") @db.Uuid
  taskId    String      @map("task_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  task      ParsingTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([userId, objectId, requestId])
  @@map("parsing_retry_receipts")
}

// Matrix catalog import. Each import keeps the raw JSONL rows verbatim; rules
// reference the parameter by code so a re-import never invalidates them.
model MatrixImport {
  id           String      @id @default(uuid()) @db.Uuid
  sourceName   String      @map("source_name")
  sourceSha256 String      @map("source_sha256") @db.Char(64)
  originSha256 String      @map("origin_sha256") @db.Char(64)
  rowCount     Int         @map("row_count")
  importedBy   String?     @map("imported_by")
  importedAt   DateTime    @default(now()) @map("imported_at") @db.Timestamptz(3)
  rows         MatrixRow[]

  @@unique([sourceSha256])
  @@map("matrix_imports")
}

model MatrixRow {
  id            String       @id @default(uuid()) @db.Uuid
  importId      String       @map("import_id") @db.Uuid
  parameterId   Int          @map("parameter_id")
  parameterCode String       @map("parameter_code") @db.VarChar(32)
  pdSection     String       @map("pd_section")
  name          String
  unit          String?
  sourcePd      String?      @map("source_pd")
  sourceRd      String?      @map("source_rd")
  sourceId      String?      @map("source_id")
  triggerText   String       @map("trigger_text")
  criticality   String?
  matrixRow     Int          @map("matrix_row")
  raw           Json
  import        MatrixImport @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([importId, parameterId])
  @@unique([importId, parameterCode])
  @@index([parameterCode])
  @@map("matrix_rows")
}

enum RuleStatus {
  draft
  approved
  rejected
  deprecated
}

// A versioned extraction plan for one matrix parameter. Only the newest
// approved version is executed; drafts are never picked up by the worker.
model RuleVersion {
  id            String     @id @default(uuid()) @db.Uuid
  parameterCode String     @map("parameter_code") @db.VarChar(32)
  parameterId   Int        @map("parameter_id")
  version       Int
  status        RuleStatus @default(draft)
  plan          Json
  comparison    Json?
  applicability Json?
  note          String?
  createdBy     String?    @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedBy    String?    @map("approved_by")
  approvedAt    DateTime?  @map("approved_at") @db.Timestamptz(3)

  @@unique([parameterCode, version])
  @@index([status, parameterCode])
  @@map("rule_versions")
}

// Same lifecycle as ClassificationTask: one task per artifact per ruleset
// fingerprint; a changed approved ruleset starts a new cycle.
model ExtractionTask {
  resolvedInputHash String?       @map("resolved_input_hash") @db.Char(64)
  id                String        @id @default(uuid()) @db.Uuid
  artifactId        String        @map("artifact_id") @db.Uuid
  cycle             Int           @default(1)
  fingerprint       String        @db.Char(64)
  state             String        @default("queued")
  attempts          Int           @default(0)
  availableAt       DateTime      @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt      DateTime?     @map("dispatched_at") @db.Timestamptz(3)
  leaseUntil        DateTime?     @map("lease_until") @db.Timestamptz(3)
  leaseToken        String?       @map("lease_token") @db.Uuid
  errorCode         String?       @map("error_code")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(3)
  artifact          ParseArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  extractions       Extraction[]

  @@unique([artifactId, cycle])
  @@index([state, availableAt, leaseUntil])
  @@map("extraction_tasks")
}

// One extracted value (or an explicit negative outcome) for one parameter in
// one artifact. Extractions are facts only: they never carry a verdict.
model Extraction {
  id            String             @id @default(uuid()) @db.Uuid
  taskId        String             @map("task_id") @db.Uuid
  artifactId    String             @map("artifact_id") @db.Uuid
  fileId        String             @map("file_id") @db.Uuid
  objectId      String             @map("object_id") @db.Uuid
  processId     String             @map("process_id") @db.Uuid
  runId         String             @map("run_id") @db.Uuid
  parameterCode String             @map("parameter_code") @db.VarChar(32)
  ruleVersionId String             @map("rule_version_id") @db.Uuid
  status        String
  stage         String?
  valueRaw      String?            @map("value_raw")
  value         Json?
  unit          String?
  alternatives  Json?
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  task          ExtractionTask     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  evidence      EvidenceFragment[]

  @@index([taskId])
  @@index([objectId, parameterCode])
  @@map("extractions")
}

model EvidenceFragment {
  id             String     @id @default(uuid()) @db.Uuid
  extractionId   String     @map("extraction_id") @db.Uuid
  fileId         String     @map("file_id") @db.Uuid
  artifactId     String     @map("artifact_id") @db.Uuid
  pageNumber     Int        @map("page_number")
  sheetLabel     String?    @map("sheet_label")
  blockId        String?    @map("block_id")
  tableId        String?    @map("table_id")
  tableRow       Int?       @map("table_row")
  tableColumn    Int?       @map("table_column")
  quote          String
  bbox           Json?
  structuralPath String?    @map("structural_path")
  extraction     Extraction @relation(fields: [extractionId], references: [id], onDelete: Restrict)

  @@index([extractionId])
  @@map("evidence_fragments")
}

// Grouped extractions for one parameter on one object: expected role comes
// from PD-stage files, actual from RD/ID; unknown stage is kept explicit.
model EvidenceGroup {
  id                String                 @id @default(uuid()) @db.Uuid
  version           Int                    @default(1)
  objectId          String                 @map("object_id") @db.Uuid
  processId         String                 @map("process_id") @db.Uuid
  runId             String?                @map("run_id") @db.Uuid
  resolvedInputHash String?                @map("resolved_input_hash") @db.Char(64)
  contextKey        String                 @default("") @map("context_key")
  contentHash       String?                @map("content_hash") @db.Char(64)
  parameterCode     String                 @map("parameter_code") @db.VarChar(32)
  scopeKey          String                 @default("") @map("scope_key")
  rulesetHash       String                 @map("ruleset_hash") @db.Char(64)
  members           Json
  verdict           Json?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  run               Run?                   @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  resolvedInput     ResolvedInputSnapshot? @relation(fields: [runId, resolvedInputHash], references: [runId, resolvedInputHash], onDelete: Restrict)

  @@unique([runId, resolvedInputHash, parameterCode, contextKey, contentHash], map: "evidence_groups_snapshot_content_key")
  @@unique([runId, resolvedInputHash, parameterCode, contextKey, version], map: "evidence_groups_snapshot_version_key")
  @@index([objectId, processId, runId])
  @@map("evidence_groups")
}

enum FrameworkSetStatus {
  draft
  approved
  deprecated
}

// Versioned normative framework set (design D6): code vocabularies, baseline
// requirements and the matrix-section mapping. Rows are approved by an
// administrator; a new revision creates a new set, old sets stay readable.
model FrameworkSet {
  id           String                    @id @default(uuid()) @db.Uuid
  version      Int
  status       FrameworkSetStatus        @default(draft)
  note         String?
  sourceName   String?                   @map("source_name")
  sourceSha256 String?                   @map("source_sha256") @db.Char(64)
  createdBy    String?                   @map("created_by")
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedBy   String?                   @map("approved_by")
  approvedAt   DateTime?                 @map("approved_at") @db.Timestamptz(3)
  vocabularies FrameworkVocabulary[]
  requirements FrameworkRequirement[]
  mappings     FrameworkSectionMapping[]
  packages     PackageVersion[]

  @@unique([version])
  @@unique([sourceSha256])
  @@map("framework_sets")
}

// Code dictionary entry: pd_section | rd_mark | id_kind | matrix_section.
model FrameworkVocabulary {
  id      String       @id @default(uuid()) @db.Uuid
  setId   String       @map("set_id") @db.Uuid
  kind    String
  code    String
  title   String
  normRef String?      @map("norm_ref")
  set     FrameworkSet @relation(fields: [setId], references: [id], onDelete: Restrict)

  @@unique([setId, kind, code])
  @@map("framework_vocabularies")
}

// Baseline requirement template. quantity.per = list_item marks a generator:
// it expands once per object list item at package-generation time.
model FrameworkRequirement {
  id                  String               @id @default(uuid()) @db.Uuid
  setId               String               @map("set_id") @db.Uuid
  code                String
  stage               String
  kindCode            String               @map("kind_code")
  title               String
  normRef             String?              @map("norm_ref")
  applicability       Json?
  quantity            Json
  alternatives        Json?
  set                 FrameworkSet         @relation(fields: [setId], references: [id], onDelete: Restrict)
  packageRequirements PackageRequirement[]

  @@unique([setId, code])
  @@map("framework_requirements")
}

// §6 ТЗ correspondence: matrix section -> expected document codes per stage.
model FrameworkSectionMapping {
  id            String       @id @default(uuid()) @db.Uuid
  setId         String       @map("set_id") @db.Uuid
  matrixSection String       @map("matrix_section")
  stage         String
  code          String?
  sourceText    String?      @map("source_text")
  set           FrameworkSet @relation(fields: [setId], references: [id], onDelete: Restrict)

  @@map("framework_section_mappings")
}

enum PackageStatus {
  proposed
  confirmed
}

// One version of an object's expected package: framework rows filtered by the
// confirmed object attributes plus extracted object lists. Confirmation is a
// separate inspector action with a basis; old versions stay immutable.
model PackageVersion {
  id              String                  @id @default(uuid()) @db.Uuid
  objectId        String                  @map("object_id") @db.Uuid
  processId       String?                 @map("process_id") @db.Uuid
  version         Int
  status          PackageStatus           @default(proposed)
  frameworkSetId  String                  @map("framework_set_id") @db.Uuid
  attributes      Json
  basis           String?
  createdBy       String?                 @map("created_by")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedBy     String?                 @map("confirmed_by")
  confirmedAt     DateTime?               @map("confirmed_at") @db.Timestamptz(3)
  object          ConstructionObject      @relation(fields: [objectId], references: [id], onDelete: Restrict)
  frameworkSet    FrameworkSet            @relation(fields: [frameworkSetId], references: [id], onDelete: Restrict)
  requirements    PackageRequirement[]
  listItems       PackageListItem[]
  results         CompletenessResult[]
  confirmReceipts PackageConfirmReceipt[]

  @@unique([objectId, version])
  @@index([objectId, status, createdAt])
  @@map("package_versions")
}

// Confirmed object-level list (e.g. hidden-work types from general data).
// Generator requirements expand one row per item; the item keeps its source
// so the inspector approves the basis, not an opaque blob.
model PackageListItem {
  id               String               @id @default(uuid()) @db.Uuid
  packageVersionId String               @map("package_version_id") @db.Uuid
  listKind         String               @map("list_kind")
  itemKey          String               @map("item_key")
  title            String
  source           Json?
  packageVersion   PackageVersion       @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  requirements     PackageRequirement[]

  @@index([packageVersionId, listKind])
  @@map("package_list_items")
}

// Idempotent confirmation receipt: replaying request_id returns the recorded
// version instead of creating a duplicate confirmation (same idiom as
// classification_retry_receipts).
model PackageConfirmReceipt {
  userId           String         @map("user_id")
  objectId         String         @map("object_id") @db.Uuid
  requestId        String         @map("request_id") @db.Uuid
  packageVersionId String         @map("package_version_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  packageVersion   PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)

  @@id([userId, objectId, requestId])
  @@map("package_confirm_receipts")
}

model PackageRequirement {
  id                     String                @id @default(uuid()) @db.Uuid
  packageVersionId       String                @map("package_version_id") @db.Uuid
  frameworkRequirementId String?               @map("framework_requirement_id") @db.Uuid
  listItemId             String?               @map("list_item_id") @db.Uuid
  code                   String
  stage                  String
  kindCode               String                @map("kind_code")
  title                  String
  scope                  Json?
  quantity               Json
  alternatives           Json?
  origin                 String
  excluded               Boolean               @default(false)
  exclusionReason        String?               @map("exclusion_reason")
  source                 Json?
  packageVersion         PackageVersion        @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  frameworkRequirement   FrameworkRequirement? @relation(fields: [frameworkRequirementId], references: [id], onDelete: Restrict)
  listItem               PackageListItem?      @relation(fields: [listItemId], references: [id], onDelete: Restrict)

  @@index([packageVersionId])
  @@map("package_requirements")
}

// Deterministic calculation output for a snapshot and package version; old
// results are never rewritten (CO-06). result keeps nullable aggregates with
// an explicit absent-reason instead of an invented denominator.
model CompletenessResult {
  id               String         @id @default(uuid()) @db.Uuid
  objectId         String         @map("object_id") @db.Uuid
  processId        String         @map("process_id") @db.Uuid
  runId            String         @map("run_id") @db.Uuid
  packageVersionId String         @map("package_version_id") @db.Uuid
  inputRefs        Json           @map("input_refs")
  result           Json
  createdBy        String?        @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  run              Run            @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  packageVersion   PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)

  @@index([objectId, processId, createdAt])
  @@map("completeness_results")
}

enum ProtocolStatus {
  active
  superseded
  finalized
}

// Finding lifecycle from §9.2/§9.3 ТЗ merged into one scale: service states
// (MISSING_EVIDENCE/NOT_COMPARABLE/NOT_APPLICABLE) never carry a decision.
enum FindingStatus {
  CANDIDATE
  CONFIRMED_VIOLATION
  NEGATIVE_VERIFIED
  CLARIFICATION_REQUIRED
  MISSING_EVIDENCE
  NOT_COMPARABLE
  NOT_APPLICABLE
}

// Versioned protocol snapshot built from evidence groups by an explicit
// inspector action. Old versions stay readable; only one `active` per
// process at a time (enforced by the service, not the schema).
model Protocol {
  id                   String                 @id @default(uuid()) @db.Uuid
  objectId             String                 @map("object_id") @db.Uuid
  processId            String                 @map("process_id") @db.Uuid
  runId                String                 @map("run_id") @db.Uuid
  version              Int
  status               ProtocolStatus         @default(active)
  scenario             String
  rulesetHash          String?                @map("ruleset_hash") @db.Char(64)
  inputManifestHash    String                 @map("input_manifest_hash") @db.Char(64)
  resolvedInputHash    String?                @map("resolved_input_hash") @db.Char(64)
  findingsHash         String                 @map("findings_hash") @db.Char(64)
  completenessResultId String?                @map("completeness_result_id") @db.Uuid
  content              Json
  createdBy            String                 @map("created_by") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  finalizedBy          String?                @map("finalized_by") @db.Uuid
  finalizedAt          DateTime?              @map("finalized_at") @db.Timestamptz(3)
  process              Process                @relation(fields: [processId, objectId], references: [id, objectId], onDelete: Restrict)
  run                  Run                    @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  findings             Finding[]
  resolvedInput        ResolvedInputSnapshot? @relation(fields: [runId, resolvedInputHash], references: [runId, resolvedInputHash], onDelete: Restrict)

  @@unique([processId, version])
  @@index([objectId, createdAt])
  @@map("protocols")
}

// One atomic finding per (parameter_code, scope_key) inside a protocol
// version. verdict is a snapshot — evidence groups may be rebuilt later;
// evidence_group_id is a traceability hint without FK because group rows
// are rebuilt in place. members_fingerprint decides whether an inspector
// decision carries over to the next protocol version.
model Finding {
  id                 String                   @id @default(uuid()) @db.Uuid
  protocolId         String                   @map("protocol_id") @db.Uuid
  objectId           String                   @map("object_id") @db.Uuid
  processId          String                   @map("process_id") @db.Uuid
  parameterCode      String                   @map("parameter_code") @db.VarChar(32)
  scopeKey           String                   @default("") @map("scope_key")
  status             FindingStatus
  risk               String?
  evidenceGroupId    String?                  @map("evidence_group_id") @db.Uuid
  verdict            Json?
  evidenceSnapshot   Json?                    @map("evidence_snapshot")
  gateReasons        Json?                    @map("gate_reasons")
  membersFingerprint String                   @map("members_fingerprint") @db.Char(64)
  decidedBy          String?                  @map("decided_by") @db.Uuid
  decidedAt          DateTime?                @map("decided_at") @db.Timestamptz(3)
  reasonCode         String?                  @map("reason_code")
  comment            String?
  rowVersion         Int                      @default(1) @map("row_version")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  protocol           Protocol                 @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  decisions          FindingDecision[]
  decisionReceipts   FindingDecisionReceipt[]

  @@unique([protocolId, parameterCode, scopeKey])
  @@index([objectId, status])
  @@map("findings")
}

// Immutable decision history: who moved a finding between statuses, on what
// basis and when. The finding's own columns are the denormalized head.
model FindingDecision {
  id         String                   @id @default(uuid()) @db.Uuid
  findingId  String                   @map("finding_id") @db.Uuid
  actorId    String                   @map("actor_id")
  action     String
  fromStatus FindingStatus            @map("from_status")
  toStatus   FindingStatus            @map("to_status")
  reasonCode String?                  @map("reason_code")
  comment    String?
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  finding    Finding                  @relation(fields: [findingId], references: [id], onDelete: Restrict)
  actor      User                     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  receipts   FindingDecisionReceipt[]

  @@index([findingId, createdAt])
  @@map("finding_decisions")
}

// Idempotent decision receipt, same idiom as package_confirm_receipts:
// replaying request_id returns the recorded decision, never a duplicate.
model FindingDecisionReceipt {
  userId     String          @map("user_id")
  objectId   String          @map("object_id") @db.Uuid
  requestId  String          @map("request_id") @db.Uuid
  findingId  String          @map("finding_id") @db.Uuid
  decisionId String          @map("decision_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  finding    Finding         @relation(fields: [findingId], references: [id], onDelete: Restrict)
  decision   FindingDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  @@id([userId, objectId, requestId])
  @@map("finding_decision_receipts")
}

// Logical identity is independent of storage. Only whole-document parts are
// supported by this slice; mixed bundles remain explicitly unresolved.
model Document {
  id          String             @id @default(uuid()) @db.Uuid
  objectId    String             @map("object_id") @db.Uuid
  processId   String             @map("process_id") @db.Uuid
  identityKey String             @map("identity_key")
  cardVersion Int                @default(1) @map("card_version")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  process     Process            @relation(fields: [processId, objectId], references: [id, objectId], onDelete: Restrict)
  revisions   DocumentRevision[]

  @@unique([processId, identityKey])
  @@unique([id, processId, objectId])
  @@map("documents")
}

model DocumentRevision {
  id             String             @id @default(uuid()) @db.Uuid
  documentId     String             @map("document_id") @db.Uuid
  objectId       String             @map("object_id") @db.Uuid
  processId      String             @map("process_id") @db.Uuid
  identityKey    String             @map("identity_key")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  document       Document           @relation(fields: [documentId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  parts          FileDocumentPart[]
  clarifications Clarification[]

  @@unique([documentId, identityKey])
  @@unique([id, documentId, processId, objectId])
  @@map("document_revisions")
}

model FileDocumentPart {
  id                String           @id @default(uuid()) @db.Uuid
  documentId        String           @map("document_id") @db.Uuid
  revisionId        String           @map("revision_id") @db.Uuid
  objectId          String           @map("object_id") @db.Uuid
  processId         String           @map("process_id") @db.Uuid
  runId             String           @map("run_id") @db.Uuid
  fileId            String           @map("file_id") @db.Uuid
  artifactId        String           @map("artifact_id") @db.Uuid
  sourceFingerprint String           @map("source_fingerprint") @db.Char(64)
  firstPage         Int              @default(1) @map("first_page")
  lastPage          Int              @map("last_page")
  machine           Json
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  revision          DocumentRevision @relation(fields: [revisionId, documentId, processId, objectId], references: [id, documentId, processId, objectId], onDelete: Restrict)
  file              File             @relation(fields: [fileId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  run               Run              @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  artifact          ParseArtifact    @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  candidates        FieldCandidate[]

  @@unique([runId, fileId, sourceFingerprint])
  @@index([artifactId])
  @@map("file_document_parts")
}

model FieldCandidate {
  id           String           @id @default(uuid()) @db.Uuid
  partId       String           @map("part_id") @db.Uuid
  field        String
  raw          String
  normalized   String?
  role         String
  evidence     Json
  method       String
  rulesVersion String           @map("rules_version")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  part         FileDocumentPart @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([partId, field])
  @@map("field_candidates")
}

// Human overrides never alter machine observations. Snapshots capture which
// decisions were used; retries apply the same immutable decision history.
model Clarification {
  id          String           @id @default(uuid()) @db.Uuid
  documentId  String           @map("document_id") @db.Uuid
  revisionId  String           @map("revision_id") @db.Uuid
  objectId    String           @map("object_id") @db.Uuid
  processId   String           @map("process_id") @db.Uuid
  runId       String           @map("run_id") @db.Uuid
  actorId     String           @map("actor_id")
  requestId   String           @map("request_id") @db.Uuid
  cardVersion Int              @map("card_version")
  basis       String
  patch       Json
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  revision    DocumentRevision @relation(fields: [revisionId, documentId, processId, objectId], references: [id, documentId, processId, objectId], onDelete: Restrict)

  @@index([revisionId, cardVersion])
  @@map("document_clarifications")
}

model ResolvedInputSnapshot {
  id                String          @id @default(uuid()) @db.Uuid
  version           Int             @default(1)
  objectId          String          @map("object_id") @db.Uuid
  processId         String          @map("process_id") @db.Uuid
  runId             String          @map("run_id") @db.Uuid
  inputManifestHash String          @map("input_manifest_hash") @db.Char(64)
  resolvedInputHash String          @map("resolved_input_hash") @db.Char(64)
  sourceFingerprint String          @map("source_fingerprint") @db.Char(64)
  snapshot          Json
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  run               Run             @relation(fields: [runId, processId, objectId], references: [id, processId, objectId], onDelete: Restrict)
  evidenceGroups    EvidenceGroup[]
  protocols         Protocol[]

  @@unique([runId, sourceFingerprint])
  @@unique([runId, version])
  @@unique([runId, resolvedInputHash])
  @@index([processId, createdAt])
  @@map("resolved_input_snapshots")
}

model DocumentResolutionReceipt {
  userId      String   @map("user_id")
  processId   String   @map("process_id") @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  fingerprint String   @db.Char(64)
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, processId, requestId])
  @@map("document_resolution_receipts")
}

model IdentificationTask {
  id           String    @id @default(uuid()) @db.Uuid
  runId        String    @map("run_id") @db.Uuid
  processId    String    @map("process_id") @db.Uuid
  objectId     String    @map("object_id") @db.Uuid
  fingerprint  String    @db.Char(64)
  state        String    @default("queued")
  attempts     Int       @default(0)
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseToken   String?   @map("lease_token") @db.Uuid
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  errorCode    String?   @map("error_code")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)

  @@unique([runId, fingerprint])
  @@index([state, availableAt, leaseUntil])
  @@map("identification_tasks")
}
