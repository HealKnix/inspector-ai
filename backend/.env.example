DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Optional separate service credential for /api/internal/metrics and worker /metrics.
# Empty disables metrics endpoints. Use 32–256 random characters, never a JWT/user token.
METRICS_TOKEN=
PORT=3000
TRUST_PROXY_HOPS=0

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=20m
JWT_REFRESH_TTL=7d
STORAGE_ROOT=./var/documents
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
FILE_VALIDATOR_URL=http://127.0.0.1:8081
FILE_VALIDATOR_TIMEOUT_SECONDS=180
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
PARSER_URL=http://127.0.0.1:8090
PARSER_TOKEN=
PARSER_FILE_TIMEOUT_SECONDS=600
PARSER_MODEL_READY_WAIT_SECONDS=300
REDIS_URL=redis://127.0.0.1:6379

# Keep identical on the HTTP backend and classification worker. API key is server-only.
CLASSIFICATION_LLM_ENABLED=false
CLASSIFICATION_LLM_BASE_URL=https://openrouter.ai/api/v1
CLASSIFICATION_LLM_MODEL=qwen/qwen3.8-27b
CLASSIFICATION_LLM_API_KEY=
CLASSIFICATION_LLM_RESPONSE_FORMAT=json_schema
CLASSIFICATION_LLM_TIMEOUT_MS=240000
CLASSIFICATION_LLM_MAX_RESPONSE_BYTES=131072
CLASSIFICATION_WORKER_HEALTH_PORT=3003
EXTRACTION_WORKER_HEALTH_PORT=3004

# Section-first LLM comparison. Disabled by default; a configured
# classification provider alone never enables sending section text.
# Endpoint properties below default to the CLASSIFICATION_LLM_* values and only
# need to be set for a documented section-specific override.
SECTION_LLM_ENABLED=false
SECTION_LLM_BASE_URL=
SECTION_LLM_MODEL=
SECTION_LLM_API_KEY=
SECTION_LLM_TIMEOUT_MS=
SECTION_LLM_MAX_REQUEST_BYTES=262144
SECTION_LLM_MAX_RESPONSE_BYTES=
SECTION_LLM_MAX_CANDIDATE_BYTES=49152
SECTION_LLM_MAX_CHUNK_BYTES=98304
SECTION_LLM_MAX_BLOCK_CHARACTERS=4000
SECTION_LLM_MAX_PARAMETERS_PER_REQUEST=8
SECTION_LLM_MAX_CALLS=32
SECTION_LLM_MAX_EXPANSION_CANDIDATES=8
