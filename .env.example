# Docker Compose PostgreSQL defaults
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
FRONTEND_PORT=8080

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=20m
JWT_REFRESH_TTL=7d

# Shared structural validation budget for API and isolated validator (25..300 seconds).
FILE_VALIDATOR_TIMEOUT_SECONDS=180

# Internal parser authentication. Generate a separate random secret of >=32 characters.
PARSER_TOKEN=
PARSER_FILE_TIMEOUT_SECONDS=600
PARSER_MODEL_READY_WAIT_SECONDS=300
PARSER_CPU_THREADS=2

# Classification uses local rules first; enabling LLM sends bounded title text to the configured provider.
CLASSIFICATION_LLM_ENABLED=false
CLASSIFICATION_LLM_BASE_URL=https://openrouter.ai/api/v1
CLASSIFICATION_LLM_MODEL=qwen/qwen3.8-27b
CLASSIFICATION_LLM_API_KEY=
CLASSIFICATION_LLM_RESPONSE_FORMAT=json_schema
CLASSIFICATION_LLM_TIMEOUT_MS=60000
CLASSIFICATION_LLM_MAX_RESPONSE_BYTES=131072
