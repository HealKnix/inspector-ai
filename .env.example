# Docker Compose PostgreSQL defaults
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
FRONTEND_PORT=8080

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=20m
JWT_REFRESH_TTL=7d

# Shared structural validation budget for API and isolated validator (25..300 seconds).
FILE_VALIDATOR_TIMEOUT_SECONDS=180

# Internal parser authentication. Generate a separate random secret of >=32 characters.
PARSER_TOKEN=
PARSER_FILE_TIMEOUT_SECONDS=600
PARSER_MODEL_READY_WAIT_SECONDS=300
PARSER_CPU_THREADS=2

# LLM-контур включён по умолчанию. Дефолтный endpoint — сервис ollama из
# compose.ollama.yaml (запуск: -f compose.yaml -f compose.ollama.yaml),
# модель qwen3.8:27b. Без встроенного Ollama укажите здесь внешний
# OpenAI-совместимый endpoint и модель — например OpenRouter:
# CLASSIFICATION_LLM_BASE_URL=https://openrouter.ai/api/v1
# CLASSIFICATION_LLM_MODEL=qwen/qwen3.8-27b
# CLASSIFICATION_LLM_API_KEY=<ключ OpenRouter>
CLASSIFICATION_LLM_ENABLED=true
CLASSIFICATION_LLM_BASE_URL=
CLASSIFICATION_LLM_MODEL=
CLASSIFICATION_LLM_API_KEY=
CLASSIFICATION_LLM_RESPONSE_FORMAT=json_schema
CLASSIFICATION_LLM_TIMEOUT_MS=240000
CLASSIFICATION_LLM_MAX_RESPONSE_BYTES=131072

# Модель, которую скачивает compose.ollama.yaml при запуске с Ollama.
OLLAMA_MODEL=qwen3.8:27b

# Section-first comparison. Enabled by default; forwarded only to the
# backend and extraction-worker services. Empty endpoint values inherit the
# CLASSIFICATION_LLM_* settings; set them only for a section-specific override.
SECTION_LLM_ENABLED=true
SECTION_LLM_BASE_URL=
SECTION_LLM_MODEL=
SECTION_LLM_API_KEY=
SECTION_LLM_TIMEOUT_MS=
SECTION_LLM_MAX_REQUEST_BYTES=262144
SECTION_LLM_MAX_RESPONSE_BYTES=
SECTION_LLM_MAX_CANDIDATE_BYTES=49152
SECTION_LLM_MAX_CHUNK_BYTES=98304
SECTION_LLM_MAX_BLOCK_CHARACTERS=4000
SECTION_LLM_MAX_PARAMETERS_PER_REQUEST=8
SECTION_LLM_MAX_CALLS=32
SECTION_LLM_MAX_EXPANSION_CANDIDATES=8
