# Docker Compose PostgreSQL defaults
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
FRONTEND_PORT=8080

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=20m
JWT_REFRESH_TTL=7d

# Internal parser authentication. Generate a separate random secret of >=32 characters.
PARSER_TOKEN=
PARSER_FILE_TIMEOUT_SECONDS=600
PARSER_CPU_THREADS=2
